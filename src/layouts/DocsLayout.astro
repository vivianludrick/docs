---
/**
 * Article layout: banner strip → title block → optional "Watch" carousel →
 * the article at a book-like measure → Up next / prev-next. The doc's hue is exposed
 * as `--doc-hue` on <main class="doc-scope"> and drives every accent below.
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import VideoCarousel from "../components/catalog/VideoCarousel.svelte";
import ReadingProgress from "../components/reading/ReadingProgress.svelte";
import TocDrawer from "../components/reading/TocDrawer.svelte";
import UpNext from "../components/reading/UpNext.astro";
import PlaylistDrawer from "../components/reading/PlaylistDrawer.svelte";
import BookmarkButton from "../components/BookmarkButton.svelte";
import type { Crumb, Video } from "../lib/nav";
import { getFlatNav } from "../lib/nav";
import { withBase } from "../lib/utils";
import { site } from "../site.config";
import { ArrowLeft, ArrowRight, Calendar, Clock, ListVideo, Pencil, Play } from "lucide-svelte";

interface PlaylistInfo {
  id: string;
  title: string;
  href: string; // without base
  docs: { id: string; title: string; href: string; readingMinutes?: number; hasVideo?: boolean }[];
}

interface Props {
  title: string;
  description?: string;
  /** Path without base, e.g. "/notes/svelte-runes". */
  current: string;
  headings: { depth: number; slug: string; text: string }[];
  updated?: Date;
  tags?: string[];
  editPath?: string;
  crumbs?: Crumb[];
  /** Raw markdown, handed to the AI assistant via #doc-context. */
  body?: string;
  banner?: string;
  hue?: number;
  readingMinutes?: number;
  videos?: Video[];
  /** The playlist this doc belongs to, if any. */
  playlist?: PlaylistInfo | null;
}
const {
  title,
  description,
  current,
  headings,
  updated,
  tags = [],
  editPath,
  crumbs = [],
  body = "",
  banner,
  hue = 220,
  readingMinutes,
  videos = [],
  playlist = null,
} = Astro.props;

const flat = await getFlatNav();
const idx = flat.findIndex((l) => l.href === current);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;

// "Up next": the following doc in the playlist, else the next doc in the flat nav.
const plIdx = playlist ? playlist.docs.findIndex((d) => d.href === current) : -1;
const plNext = playlist && plIdx >= 0 && plIdx < playlist.docs.length - 1 ? playlist.docs[plIdx + 1] : null;
const upNext = plNext
  ? { eyebrow: `Up next in ${playlist!.title}`, ...plNext }
  : next
    ? { eyebrow: "Up next", title: next.title, href: next.href }
    : null;

const repo = site.repoUrl;
const updatedLabel = updated?.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

// JSON for the AI assistant; `</` is escaped so a closing tag in the markdown can't end the script.
const docContextJson = JSON.stringify({ title, href: current, description, body }).replace(/<\//g, "<\\/");
---

<BaseLayout {title} {description} bodyClass="is-article" tabBar={false} assistant>
  <ReadingProgress client:load {hue} {title} href={current} />

  <main class="doc-scope min-w-0 flex-1" style={`--doc-hue: ${hue}`}>
    <!-- Banner strip -->
    <div class="relative h-52 w-full overflow-hidden md:h-64" aria-hidden="true">
      {banner && <img src={banner} alt="" class="h-full w-full object-cover" decoding="async" fetchpriority="high" />}
      <div class="absolute inset-0 mix-blend-multiply dark:mix-blend-screen" style={`background: hsl(${hue} 70% 50% / 0.22)`}></div>
      <div class="absolute inset-0 bg-gradient-to-b from-background/5 via-55% via-background/85 to-background"></div>
    </div>

    <!-- Title block -->
    <header class="relative mx-auto -mt-24 max-w-[68ch] px-4 md:-mt-28 md:px-0">
      <div class="flex min-w-0 items-start justify-between gap-4">
        <Breadcrumbs {crumbs} />
        <div class="-mt-1 flex shrink-0 items-center gap-2">
          <BookmarkButton client:idle href={current} {title} />
          {repo && editPath && (
            <a
              href={`${repo}/edit/${site.branch}/${editPath}`}
              target="_blank"
              rel="noreferrer"
              class="inline-flex h-8 items-center gap-1.5 rounded-md border bg-background/60 px-2.5 text-xs font-medium max-sm:w-8 max-sm:justify-center max-sm:px-0 text-muted-foreground backdrop-blur transition hover:bg-accent hover:text-foreground"
              title="Edit this page on GitHub"
            >
              <Pencil class="h-3.5 w-3.5" /><span class="hidden sm:inline">Edit</span>
            </a>
          )}
        </div>
      </div>
      <h1 class="font-display text-4xl font-semibold leading-[1.1] tracking-tight text-balance md:text-5xl">{title}</h1>
      {description && <p class="mt-4 text-lg leading-relaxed text-muted-foreground text-pretty md:text-xl">{description}</p>}
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        {readingMinutes && (
          <span class="inline-flex items-center gap-1.5"><Clock class="h-3.5 w-3.5" /> {readingMinutes} min read</span>
        )}
        {updatedLabel && (
          <span class="inline-flex items-center gap-1.5"><Calendar class="h-3.5 w-3.5" /> Updated {updatedLabel}</span>
        )}
        {playlist && (
          <a
            href={withBase(playlist.href)}
            class="inline-flex items-center gap-1.5 font-medium transition hover:text-foreground"
            style="color: var(--doc-accent)"
          >
            <ListVideo class="h-3.5 w-3.5" /> Part of {playlist.title}
          </a>
        )}
        {tags.length > 0 && (
          <ul class="flex flex-wrap items-center gap-1.5" aria-label="Tags">
            {tags.map((t) => (
              <li>
                <span class="rounded-full border px-2.5 py-0.5 text-xs" style="background: var(--doc-accent-soft); border-color: var(--doc-accent-line)">{t}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <!-- Watch -->
    {videos.length > 0 && (
      <section id="videos" class="mx-auto mt-12 max-w-5xl scroll-mt-24 px-4" aria-labelledby="watch-first">
        <div class="mx-auto mb-4 flex max-w-[68ch] items-center gap-2 md:px-0">
          <Play class="h-3.5 w-3.5" style="color: var(--doc-accent)" />
          <h2 id="watch-first" class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Watch</h2>
          <span class="text-[11px] text-muted-foreground/70">· {videos.length} video{videos.length === 1 ? "" : "s"}</span>
        </div>
        <VideoCarousel client:visible {videos} {hue} size="md" />
      </section>
    )}

    <!-- Article -->
    <div class="relative mx-auto mt-12 max-w-[68ch] px-4 md:px-0">
      <article id="article" class="prose">
        <slot />
      </article>
      <TocDrawer client:idle {headings} {hue} />
      {playlist && (
        <PlaylistDrawer
          client:idle
          title={playlist.title}
          href={playlist.href}
          docs={playlist.docs}
          {current}
          {hue}
          base={import.meta.env.BASE_URL}
        />
      )}

      {repo && editPath && (
        <p class="mt-14 text-sm">
          <a
            href={`${repo}/edit/${site.branch}/${editPath}`}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 text-muted-foreground transition hover:text-foreground"
          >
            <Pencil class="h-3.5 w-3.5" /> Edit this page on GitHub ↗
          </a>
        </p>
      )}
    </div>

    <!-- Up next / pagination -->
    <footer class="mx-auto mt-14 max-w-[68ch] space-y-10 px-4 pb-16 md:px-0">
      {upNext && (
        <UpNext
          eyebrow={upNext.eyebrow}
          title={upNext.title}
          href={upNext.href}
          readingMinutes={"readingMinutes" in upNext ? upNext.readingMinutes : undefined}
        />
      )}

      <nav class="grid grid-cols-2 gap-4 border-t pt-6" aria-label="Pagination">
        {prev ? (
          <a href={withBase(prev.href)} class="group flex min-w-0 flex-col gap-0.5 text-left">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              <ArrowLeft class="h-3 w-3 transition-transform group-hover:-translate-x-0.5" /> Previous
            </span>
            <span class="line-clamp-2 text-sm font-medium group-hover:underline">{prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={withBase(next.href)} class="group col-start-2 flex min-w-0 flex-col items-end gap-0.5 text-right">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              Next <ArrowRight class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
            </span>
            <span class="line-clamp-2 text-sm font-medium group-hover:underline">{next.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </main>

  <script is:inline type="application/json" id="doc-context" set:html={docContextJson}></script>

  <script>
    // Wrap code blocks and add one corner label showing the language (from Astro's
    // data-language on <pre>). Clicking the label copies the whole block.
    for (const pre of document.querySelectorAll<HTMLPreElement>("#article pre")) {
      if (pre.parentElement?.classList.contains("code-block")) continue;
      const wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.replaceWith(wrap);
      wrap.append(pre);

      const lang = pre.dataset.language;
      const label = lang && lang !== "plaintext" && lang !== "text" ? lang : "copy";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "lang-btn";
      btn.textContent = label;
      btn.title = "Copy code";
      btn.setAttribute("aria-label", `Copy ${label} code block`);
      let timer: ReturnType<typeof setTimeout> | undefined;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? "");
          btn.dataset.copied = "true";
          btn.textContent = "copied";
          clearTimeout(timer);
          timer = setTimeout(() => {
            delete btn.dataset.copied;
            btn.textContent = label;
          }, 1500);
        } catch {}
      });
      wrap.append(btn);
    }
  </script>
</BaseLayout>
