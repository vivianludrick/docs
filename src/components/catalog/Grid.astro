---
/** Vertical grid of cards (the page scrolls, not the row). */
import type { CatalogItem } from "../../lib/nav";
import { withBase } from "../../lib/utils";
import { ArrowRight } from "lucide-svelte";
import Card from "./Card.astro";

interface Props {
  title: string;
  items: CatalogItem[];
  href?: string;
  id?: string;
}
const { title, items, href, id } = Astro.props;
---

{items.length > 0 && (
  <section {id} class="mx-auto max-w-screen-2xl px-4 md:px-8">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-bold tracking-tight md:text-xl">{title}</h2>
      {href && (
        <a href={withBase(href)} class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition hover:text-foreground">
          See all <ArrowRight class="h-3.5 w-3.5" />
        </a>
      )}
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 md:gap-5">
      {items.map((item) => (
        <div class="relative hover:z-10">
          <Card {item} details />
        </div>
      ))}
    </div>
  </section>
)}
