---
import { ChevronRight } from "lucide-svelte";
import { withBase } from "../lib/utils";
import type { Crumb } from "../lib/nav";

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

{crumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="mb-4 min-w-0">
    <ol class="flex items-center gap-1 overflow-hidden whitespace-nowrap text-sm text-muted-foreground">
      {crumbs.map((c, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li class:list={["flex items-center gap-1", last ? "min-w-0" : "shrink-0"]}>
            {i > 0 && <ChevronRight class="h-3.5 w-3.5 shrink-0 opacity-60" />}
            {c.href && !last ? (
              <a href={withBase(c.href)} class="rounded px-1 py-0.5 transition hover:bg-accent hover:text-foreground">{c.title}</a>
            ) : (
              <span class:list={["px-1 py-0.5", last && "truncate font-medium text-foreground"]} aria-current={last ? "page" : undefined} title={c.title}>{c.title}</span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
