---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNav } from "../lib/nav";
import { withBase } from "../lib/utils";
import { ArrowRight } from "lucide-svelte";

const nav = await getNav();
const home = await getEntry("docs", "index");
const Content = home ? (await render(home)).Content : null;
const firstDoc = nav.flatMap((g) => g.links)[0];
---

<BaseLayout title={home?.data.title ?? "Vivian's Docs"} description={home?.data.description} current="/">
  <main class="min-w-0 flex-1 py-10 lg:px-10">
    <div class="prose mx-auto max-w-3xl">
      <section class="mb-10">
        <h1 class="text-5xl font-extrabold tracking-tight">{home?.data.title ?? "Docs"}</h1>
        {home?.data.description && <p class="text-lg text-muted-foreground">{home.data.description}</p>}
        {firstDoc && (
          <a href={withBase(firstDoc.href)}
            class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground no-underline hover:opacity-90">
            Start reading <ArrowRight class="h-4 w-4" />
          </a>
        )}
      </section>

      {Content && <Content />}

      <section class="not-prose mt-12 grid gap-4 sm:grid-cols-2">
        {nav.filter((g) => g.links.length).map((g) => (
          <a href={withBase(g.links[0].href)} class="rounded-xl border bg-card p-5 transition hover:bg-accent">
            <h3 class="text-base font-semibold">{g.label}</h3>
            <p class="mt-1 text-sm text-muted-foreground">
              {g.links.length} page{g.links.length === 1 ? "" : "s"} · {g.links.slice(0, 3).map((l) => l.title).join(", ")}
            </p>
          </a>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>
