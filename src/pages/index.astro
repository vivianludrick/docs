---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog } from "../lib/nav";
import { getEntry } from "astro:content";
import Hero from "../components/catalog/Hero.astro";
import { toSlide } from "../components/catalog/hero";
import SearchBar from "../components/catalog/SearchBar.astro";
import Row from "../components/catalog/Row.astro";
import Grid from "../components/catalog/Grid.astro";
import ContinueReading from "../components/catalog/ContinueReading.svelte";
import Bookmarks from "../components/catalog/Bookmarks.svelte";

const catalog = await getCatalog();
const home = await getEntry("docs", "index");

const featured = catalog.featured.length ? catalog.featured : catalog.playlists.slice(0, 1);
const slides = featured.map((i) => toSlide(i));

// href (without base) -> card data, so "Continue reading" can show banners.
const progressMeta = Object.fromEntries(
  [...catalog.playlists, ...catalog.docs].map((i) => [i.href, { title: i.title, banner: i.banner, hue: i.hue, kind: i.kind }]),
);
---

<BaseLayout title={home?.data.title ?? "Vivian's Docs"} description={home?.data.description} variant="immersive">
  <main class="flex-1 pb-16">
    {slides.length > 0 ? (
      <Hero {slides} />
    ) : (
      <section class="mx-auto max-w-screen-2xl px-4 pb-10 pt-36 md:px-8">
        <h1 class="text-5xl font-extrabold tracking-tight md:text-6xl">{home?.data.title ?? "Docs"}</h1>
        {home?.data.description && <p class="mt-4 max-w-xl text-lg text-muted-foreground">{home.data.description}</p>}
      </section>
    )}

    <div class="relative z-10 mx-auto -mt-6 max-w-screen-2xl px-4 md:-mt-8 md:px-8">
      <SearchBar class="max-w-2xl" />
    </div>

    <div class="mt-12 space-y-6 md:mt-16 md:space-y-8">
      <ContinueReading client:load items={progressMeta} base={import.meta.env.BASE_URL} />

      <Row title="Recently updated" items={catalog.recent} />
      <Bookmarks client:load items={progressMeta} base={import.meta.env.BASE_URL} />
      <Grid title="All articles" items={catalog.docs} href="/library" />
    </div>
  </main>
</BaseLayout>
