---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog } from "../lib/nav";
import Card from "../components/catalog/Card.astro";
import LibraryFilter from "../components/catalog/LibraryFilter.svelte";
import { Library } from "lucide-svelte";

const catalog = await getCatalog();
const items = [...catalog.playlists, ...catalog.docs];
const tagCounts = catalog.tags.map(([t, i]) => [t, i.length] as [string, number]);
---

<BaseLayout title="Library" description="Every article and playlist, filterable.">
  <main class="mx-auto w-full max-w-screen-2xl flex-1 px-4 pb-20 pt-10 md:px-8 md:pt-14">
    <header class="mb-8">
      <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
        <Library class="h-3.5 w-3.5" /> Everything
      </p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight md:text-5xl">Library</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {catalog.docs.length} {catalog.docs.length === 1 ? "article" : "articles"} · {catalog.playlists.length} {catalog.playlists.length === 1 ? "playlist" : "playlists"}
      </p>
    </header>

    <div class="sticky top-16 z-20 -mx-4 mb-10 bg-background/85 px-4 py-4 backdrop-blur md:-mx-8 md:px-8">
      <LibraryFilter client:load tags={tagCounts} target="library-grid" />
    </div>

    <div id="library-grid" class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {items.map((item) => (
        <div
          data-card
          data-kind={item.kind}
          data-title={item.title}
          data-description={item.description ?? ""}
          data-tags={item.tags.join(",")}
        >
          <Card {item} details size="lg" />
        </div>
      ))}
    </div>
    <p id="library-grid-empty" class="hidden rounded-xl border border-dashed p-10 text-center text-muted-foreground">
      Nothing matches those filters.
    </p>
  </main>
</BaseLayout>
