---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getDocs, docHref, isRenderable, getBreadcrumbs } from "../lib/nav";

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs
    .filter(isRenderable)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const crumbs = await getBreadcrumbs(entry);
const docsDir = (process.env.DOCS_DIR ?? "./docs").replace(/^\.\//, "");
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={docHref(entry)}
  {headings}
  updated={entry.data.updated}
  tags={entry.data.tags}
  {crumbs}
  editPath={`${docsDir}/${entry.filePath?.split("/").slice(1).join("/") ?? ""}`}
>
  <Content />
</DocsLayout>
