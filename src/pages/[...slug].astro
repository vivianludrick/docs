---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getDocs, docHref, isRenderable, getBreadcrumbs, docToItem, getPlaylists, getPlaylistDocs, readingMinutes } from "../lib/nav";

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs
    .filter(isRenderable)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const crumbs = await getBreadcrumbs(entry);
const docsDir = (process.env.DOCS_DIR ?? "./docs").replace(/^\.\//, "");
const item = docToItem(entry);

interface PlaylistInfo {
  id: string;
  title: string;
  href: string;
  docs: { id: string; title: string; href: string; readingMinutes?: number; hasVideo?: boolean }[];
}

// The playlist this doc belongs to: `data.playlist` wins, else the first playlist listing it in `docs:`.
let playlist: PlaylistInfo | null = null;
for (const p of await getPlaylists()) {
  const docs = await getPlaylistDocs(p);
  const member = entry.data.playlist === p.id || docs.some((d) => d.id === entry.id);
  if (!member) continue;
  playlist = {
    id: p.id,
    title: p.data.title,
    href: `/playlists/${p.id}`,
    docs: docs.map((d) => ({ id: d.id, title: d.data.title, href: docHref(d), readingMinutes: readingMinutes(d.body), hasVideo: d.data.videos.length > 0 })),
  };
  if (entry.data.playlist === p.id) break;
}
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={docHref(entry)}
  {headings}
  updated={entry.data.updated}
  tags={entry.data.tags}
  {crumbs}
  editPath={`${docsDir}/${entry.filePath?.split("/").slice(1).join("/") ?? ""}`}
  body={entry.body ?? ""}
  banner={item.banner}
  hue={item.hue}
  readingMinutes={item.readingMinutes}
  videos={item.videos}
  {playlist}
>
  <Content />
</DocsLayout>
