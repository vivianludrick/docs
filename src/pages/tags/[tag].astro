---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCatalog } from "../../lib/nav";
import { withBase } from "../../lib/utils";
import Card from "../../components/catalog/Card.astro";
import { Tag } from "lucide-svelte";

export async function getStaticPaths() {
  const { tags } = await getCatalog();
  const all = tags.map(([t, i]) => [t, i.length] as [string, number]);
  return tags.map(([tag, items]) => ({ params: { tag }, props: { tag, items, all } }));
}

const { tag, items, all } = Astro.props;
const docs = items.filter((i) => i.kind === "doc").length;
const playlists = items.length - docs;
---

<BaseLayout title={`#${tag}`} description={`Everything tagged ${tag}`}>
  <main class="mx-auto w-full max-w-screen-2xl flex-1 px-4 pb-20 pt-10 md:px-8 md:pt-14">
    <header class="mb-10">
      <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
        <Tag class="h-3.5 w-3.5" /> Tag
      </p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight md:text-5xl">#{tag}</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {items.length} {items.length === 1 ? "item" : "items"}
        {playlists > 0 && ` · ${playlists} ${playlists === 1 ? "playlist" : "playlists"}`}
        {docs > 0 && ` · ${docs} ${docs === 1 ? "article" : "articles"}`}
      </p>
      <nav class="mt-5 flex flex-wrap gap-2" aria-label="Other tags">
        {all.map(([t, n]) => (
          <a
            href={withBase(`/tags/${t}`)}
            class:list={[
              "rounded-full border px-3 py-1 text-xs font-medium transition",
              t === tag ? "border-foreground bg-foreground text-background" : "bg-card text-muted-foreground hover:border-foreground/30 hover:text-foreground",
            ]}
          >
            #{t} <span class="opacity-60">{n}</span>
          </a>
        ))}
      </nav>
    </header>

    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {items.map((item) => (
        <Card {item} details size="lg" />
      ))}
    </div>
  </main>
</BaseLayout>
