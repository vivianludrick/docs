---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog } from "../lib/nav";
import Bookmarks from "../components/catalog/Bookmarks.svelte";
import { Bookmark } from "lucide-svelte";

const catalog = await getCatalog();
const meta = Object.fromEntries(
  [...catalog.playlists, ...catalog.docs].map((i) => [
    i.href,
    { title: i.title, banner: i.banner, hue: i.hue, kind: i.kind, description: i.description },
  ]),
);
---

<BaseLayout title="Bookmarks" description="Pages you saved for later.">
  <main class="mx-auto w-full max-w-screen-2xl flex-1 px-4 pb-20 pt-10 md:px-8 md:pt-14">
    <header class="mb-10">
      <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
        <Bookmark class="h-3.5 w-3.5" /> Saved in this browser
      </p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight md:text-5xl">Bookmarks</h1>
      <p class="mt-3 text-lg text-muted-foreground">Articles and playlists you've marked to come back to.</p>
    </header>
    <Bookmarks client:load items={meta} base={import.meta.env.BASE_URL} layout="grid" />
  </main>
</BaseLayout>
